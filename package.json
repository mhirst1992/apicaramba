{
  "name": "apicaramba",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm --filter @apicaramba/desktop dev",
    "build": "pnpm --filter @apicaramba/desktop build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/swagger2openapi": "^7.0.4",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "keytar"
    ],
    "overrides": {
      "esbuild": ">=0.25.0"
    }
  }
}
